# ─────────────────────────────────────────────────────────────────────
# COPY THIS FILE → rename to ".env.local" → fill in your values
# Never commit .env.local — it contains your secrets
# ─────────────────────────────────────────────────────────────────────

# ── SUPABASE (database) ────────────────────────────────────────────
# Found at: https://supabase.com/dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── CLOUDINARY (image hosting) ─────────────────────────────────────
# Found at: https://console.cloudinary.com → Settings → API Keys
# Cloud name is shown in the "Cloud name:" badge at the top of the API Keys page
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── GOOGLE GEMINI AI ────────────────────────────────────────────────
# Found at: https://aistudio.google.com/app/apikey → Create API Key
GEMINI_API_KEY=your-gemini-api-key

# ── STORE SETTINGS ─────────────────────────────────────────────────
NEXT_PUBLIC_STORE_NAME=My Store
NEXT_PUBLIC_SITE_URL=https://your-store.vercel.app

# Optional seller contact details shown on product pages.
# Phone must include country code, e.g. +2348012345678 (used for tel: links).
# WhatsApp must be digits only with country code, e.g. 2348012345678 (no + or spaces).
# Leave blank to hide the phone/WhatsApp buttons until you are ready.
NEXT_PUBLIC_SELLER_PHONE=
NEXT_PUBLIC_SELLER_WHATSAPP=

# Optional seller location / opening hours shown on product pages.
NEXT_PUBLIC_SELLER_ADDRESS=
NEXT_PUBLIC_SELLER_HOURS=

# ── TAWK.TO (live chat widget) ──────────────────────────────────────
# Found at: tawk.to → Admin → Property Settings → Widget Code
# Copy just the property ID, e.g. "64abc123456/1habcdef"
# Leave blank to disable live chat
NEXT_PUBLIC_TAWKTO_ID=

# ── ADMIN DASHBOARD ────────────────────────────────────────────────
# Password to log in at /admin — choose something strong
ADMIN_PASSWORD=YourStrongPassword123!

# ── TELEGRAM BOT (listing + all seller notifications) ──────────────
# TELEGRAM_BOT_TOKEN: message @BotFather on Telegram → /newbot → follow prompts
# TELEGRAM_CHAT_ID: message your new bot once, then visit
#   https://api.telegram.org/bot<TOKEN>/getUpdates and read "chat":{"id":...}
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Secret sent by Telegram in the X-Telegram-Bot-Api-Secret-Token header.
# Generate one with: openssl rand -hex 32
# It MUST also be passed as secret_token when calling Telegram's setWebhook.
TELEGRAM_WEBHOOK_SECRET=your-random-webhook-secret
