# ─────────────────────────────────────────────────────────────────────
# COPY THIS FILE → rename to ".env.local" → fill in your values
# Never commit .env.local — it contains your secrets
# ─────────────────────────────────────────────────────────────────────

# ── SUPABASE (database) ────────────────────────────────────────────
# Found at: https://supabase.com/dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── CLOUDINARY (image hosting) ─────────────────────────────────────
# Found at: https://console.cloudinary.com → Settings → API Keys
# Cloud name is shown in the "Cloud name:" badge at the top of the API Keys page
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── GOOGLE GEMINI AI ────────────────────────────────────────────────
# Found at: https://aistudio.google.com/app/apikey → Create API Key
GEMINI_API_KEY=your-gemini-api-key

# ── META WHATSAPP CLOUD API ─────────────────────────────────────────
# Found at: https://developers.facebook.com/apps → your app
# META_ACCESS_TOKEN: App Dashboard → WhatsApp → API Setup → Permanent Token
# META_PHONE_NUMBER_ID: WhatsApp → API Setup → Phone Number ID
# META_WABA_ID: WhatsApp → API Setup → WhatsApp Business Account ID
# META_WEBHOOK_VERIFY_TOKEN: make up any string — must match what you enter in Meta dashboard
META_ACCESS_TOKEN=your-permanent-access-token
META_PHONE_NUMBER_ID=your-phone-number-id
META_WABA_ID=your-whatsapp-business-account-id
META_WEBHOOK_VERIFY_TOKEN=your-chosen-verify-token

# ── SELLER ──────────────────────────────────────────────────────────
# Your WhatsApp number in international format without + (e.g. Nigeria: 2348012345678)
SELLER_PHONE=2348012345678

# ── STORE SETTINGS ─────────────────────────────────────────────────
NEXT_PUBLIC_STORE_NAME=My Store
NEXT_PUBLIC_SITE_URL=https://your-store.vercel.app

# ── TAWK.TO (live chat widget) ──────────────────────────────────────
# Found at: tawk.to → Admin → Property Settings → Widget Code
# Copy just the property ID, e.g. "64abc123456/1habcdef"
# Leave blank to disable live chat
NEXT_PUBLIC_TAWKTO_ID=

# ── ADMIN DASHBOARD ────────────────────────────────────────────────
# Password to log in at /admin — choose something strong
ADMIN_PASSWORD=YourStrongPassword123!
